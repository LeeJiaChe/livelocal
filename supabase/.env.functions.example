AI_API_KEY=replace-with-provider-key
# Must support Chat Completions response_format.type=json_schema.
AI_MODEL=replace-with-structured-output-model
AI_API_BASE_URL=https://api.openai.com/v1

# Generate with: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
SOCIAL_OAUTH_CALLBACK_URL=https://PROJECT_REF.supabase.co/functions/v1/social-account-oauth
SOCIAL_OAUTH_APP_REDIRECT_URI=io.livelocal.app://social-connected

TIKTOK_CLIENT_KEY=replace-with-tiktok-client-key
TIKTOK_CLIENT_SECRET=replace-with-tiktok-client-secret

INSTAGRAM_CLIENT_ID=replace-with-meta-app-id
INSTAGRAM_CLIENT_SECRET=replace-with-meta-app-secret
# Pin the Graph API version enabled for the Meta app, for example vXX.X.
META_GRAPH_API_VERSION=vXX.X
# Meta App Access Token (or another token authorized for Instagram oEmbed).
INSTAGRAM_OEMBED_ACCESS_TOKEN=replace-with-meta-oembed-access-token
